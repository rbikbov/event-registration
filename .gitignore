# dependencies
node_modules/

# env files; .env.example is committed
.env*
!.env.example

# editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# local Claude Code settings
.claude/settings.local.json

# python
.venv/
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# frontend build output and TypeScript build info
dist/
*.tsbuildinfo

# playwright
playwright-report/
test-results/

