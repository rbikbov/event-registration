{
  "name": "event-registration",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tooling": "node --test '.claude/hooks/*.test.mjs' 'scripts/*.test.mjs'",
    "prepare": "husky"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "uv run --project backend ruff check --fix",
      "uv run --project backend ruff format"
    ],
    "*.{mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
